# Mac-mini whisper pipeline (skill-mlx-api-client-whisper)
WHISPER_TARGET_REPO=ZhongZheng782/Mac-mini
WHISPER_SOURCE_REPO=wenchiehlee-money/YoutubeAudio.Fetch
WHISPER_SOURCE_TYPE=youtube
# PAT scoped to WHISPER_TARGET_REPO only, Issues: Read and write (no Contents access needed).
REPO_FILE_SYNC_ZHONGZHENG782_MONEY=<PAT>

# YouTube channel audio fetch (skill-youtube-channel-fetch)
# PAT scoped to WHISPER_SOURCE_REPO (this repo), Contents: Read and write
# (used to publish downloaded audio as GitHub Release assets).
# Naming follows the same REPO_FILE_SYNC_<OWNER>_<...> convention as the whisper
# pipeline's target-repo token above, just scoped to the source repo's owner.
REPO_FILE_SYNC_WENCHIEHLEE_MONEY=<PAT>
# Fallbacks if the above isn't set: YOUTUBE_FETCH_TOKEN=<PAT> or GH_TOKEN=<PAT>

# SRT keyframe extraction (skill-srt-keyframe-extract)
# Calls the shared ../llm package (LLMClient) instead of any LLM API directly.
# Set env vars for whichever provider(s) you want in its fallback chain
# (codex -> gemini -> mlx by default); see ../llm/README.md for the full list.
GEMINI_API_KEY=<key>
# CODEX_API_URL=<url>
# CODEX_API_KEY=<key>
# MLX_API_URL=<url>
# MLX_SERVER_API_KEY=<key>
# Optional: enables ../llm's Amplitude call tracking (provider/model/duration/success
# per app_name). Without it, tracking is silently a no-op — no error, nothing sent.
# AMPLITUDE_API_KEY=<key>
